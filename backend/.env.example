# kok_app 롤 접속(런타임: Neon 풀러 URL, 로컬: compose의 db). 값은 예시일 뿐 — 실제 비밀번호는 환경 파일/플랫폼 시크릿에만.
DATABASE_URL="postgresql://kok_app:kok_app@localhost:5432/kok?schema=public"
# 마이그레이션(prisma migrate) 전용 직결 URL
DIRECT_URL="postgresql://kok_app:kok_app@localhost:5432/kok?schema=public"
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
PORT=3000
CORS_ORIGINS="http://localhost:5173"
# 명시적 false가 아니면 데모 admin의 관리자 변경 API 403(DEMO_READ_ONLY) — 운영은 true(또는 미설정)
DEMO_ADMIN_READONLY=false
# 리버스 프록시 뒤에서 req.ip 신뢰 (예: 1)
TRUST_PROXY=0
# FastAPI 내부 호출
AI_BASE_URL="http://localhost:8000"
INTERNAL_API_TOKEN="change-me-internal"
# 전역 요청 한도(분당/IP) 기본값 조정용 — 기본 120
THROTTLE_DEFAULT_LIMIT=120
# ── 수집 배치(node dist/cli.js ingest) ──
# fine-grained PAT(공개 저장소 읽기 전용). 비어 있으면 CLI 기동 실패
GITHUB_TOKEN_INGEST=""
MAX_TRACKED_REPOS=2000
MAX_ITEMS_PER_REPO=50
# core 잔량이 이 값 미만이면 단계 PAUSED
GITHUB_CORE_RESERVE=200
# OSS Insight는 2026-12-04 종료 예정 — 기본 none
EXTERNAL_STAR_SOURCE=none
EXTERNAL_STAR_SOURCE_UNTIL=2026-12-03
# 로컬 픽스처 서버(scripts/fake-github-server.ts) 사용 시에만
# GITHUB_API_BASE=http://127.0.0.1:4010
# GITHUB_RAW_BASE=http://127.0.0.1:4010/raw
# 배치 advisory lock용 직결 URL(풀러 불가) — 위 DIRECT_URL 재사용
