{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testTimeout": 180000,
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@nestjs/jwt|@nestjs/config|@nestjs/passport)/)"
  ]
}
