# kok_ai 롤 접속(psycopg3 드라이버). 값은 예시일 뿐 — 실제 비밀번호는 환경 파일/플랫폼 시크릿에만.
AI_DATABASE_URL="postgresql+psycopg://kok_ai:kok_ai@localhost:5432/kok"
# NestJS·배치 → FastAPI 내부 호출 토큰(backend와 같은 값)
INTERNAL_API_TOKEN="change-me-internal"
APP_ENV="development" # production이면 /docs 비활성

# 외부 API 키 — 없으면 요약은 FAILED, 검색은 BM25 degraded로 동작(테스트·CI는 키 불필요)
ANTHROPIC_API_KEY=""
VOYAGE_API_KEY=""
SUMMARY_MODEL="claude-haiku-5-5" # PLAN C7 평가 후 확정
ANSWER_MODEL="claude-haiku-5-5"
EMBED_MODEL="voyage-4"
RERANK_MODEL="rerank-3-lite"

# 일일 AI 예산(UTC 기준, 풀 SUMMARY/SEARCH/ANSWER 비율)
DAILY_AI_BUDGET_USD="1.0"
AI_BUDGET_SPLIT="60/20/20"
# MODEL_PRICES='{"claude-haiku-5-5":[1.0,5.0]}' # [입력,출력] USD/MTok. [미검증: 실제 단가] 기본은 보수적 값
